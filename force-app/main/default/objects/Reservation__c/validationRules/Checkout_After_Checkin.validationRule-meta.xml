<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Checkout_After_Checkin</fullName>
    <active>true</active>
    <errorConditionFormula
  >Check_Out_Date__c &lt;= Check_In_Date__c</errorConditionFormula>
    <errorMessage
  >La fecha de Check-Out debe ser posterior a la fecha de Check-In.</errorMessage>
    <errorDisplayField>Check_Out_Date__c</errorDisplayField>
</ValidationRule>
